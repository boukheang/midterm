# Local development (running a service with `node index.js` outside Kubernetes).
# Copy to .env in the service folder you are running. Never commit real values.
MONGO_URI=mongodb://localhost:27017/smart_campus_access_db
# At least 32 random characters. The gateway and authentication service refuse to start without it.
JWT_SECRET=replace-with-at-least-32-random-characters
# Bootstrap admin created by the Registration service on startup.
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=replace-with-admin-password
