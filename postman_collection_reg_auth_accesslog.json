      "item": [
        {
          "name": "0.1 API Gateway Health & Upstream Map",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Gateway status is UP', function () {",
                  "    pm.expect(json.status).to.eql('UP');",
                  "});",
                  "pm.test('Upstream services registered', function () {",
                  "    pm.expect(json.upstreamServices).to.have.property('registration');",
                  "    pm.expect(json.upstreamServices).to.have.property('authentication');",
                  "    pm.expect(json.upstreamServices).to.have.property('accessLogLoadBalancedPool');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
