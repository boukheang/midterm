    {
      "name": "4. Access Log & Round-Robin Load Balancer (accesslog)",
      "item": [
        {
          "name": "4.1 Badge Swipe Request 1 (Routes to Node 1 - Port 5005)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Header X-Load-Balanced-By is API-Gateway-RoundRobin', function () {",
                  "    pm.expect(pm.response.headers.get('X-Load-Balanced-By')).to.eql('API-Gateway-RoundRobin');",
                  "});",
                  "pm.test('Header X-Served-By-Instance is present', function () {",
                  "    const inst = pm.response.headers.get('X-Served-By-Instance');",
                  "    pm.expect(inst).to.be.oneOf(['AccessLog-Instance-1', 'AccessLog-Instance-2']);",
                  "    pm.collectionVariables.set('firstSwipeInstance', inst);",
                  "    console.log('Swipe 1 served by:', inst, 'port:', pm.response.headers.get('X-Served-By-Port'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
